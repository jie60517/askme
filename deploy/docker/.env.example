# compose.yml 用的值。複製成 .env 後填:cp .env.example .env
# ⚠️ 這份檔裡有 API key 與資料庫密碼,只放在這台主機上,不要 commit。

# 跑哪一版 image(docker build 時 -t askme:<這個值>)。退版就改回上一個 tag 再 docker compose up -d
ASKME_TAG=local

# 網站開在哪個 port;內網其他電腦用 http://<這台主機的 IP>:<port> 連
ASKME_PORT=8100
# 0.0.0.0 = 內網都連得到;只給這台主機自己用改成 127.0.0.1
ASKME_BIND=0.0.0.0

# 資料庫密碼(隨便一串長的,不會用來登入網站)。第一次 up 之後就不要改,改了要先在資料庫裡 ALTER USER
PG_PASSWORD=

# Claude 怎麼登入(改了要 docker compose up -d --force-recreate askme):
#   subscription  用 Claude 的訂閱帳號(Pro / Max)。裝好後跑一次登入,見 README.md。
#                 ⚠️ 只適合**一個人自己用**:訂閱是個人方案,不能給別人共用;
#                 而且登入資料放在 AI 讀得到的地方(askme 容器的 ~/.claude)
#   apikey        用 API key(下一行),key 只交給 keyproxy 容器,網站與 AI 看不到。多人用請選這個
CLAUDE_AUTH=subscription

# Claude API key(console.anthropic.com 申請,sk-ant- 開頭)。CLAUDE_AUTH=apikey 才要填
ANTHROPIC_API_KEY=

# 要問的專案放在哪個資料夾(預設是旁邊的 projects/)。容器裡一律看成 /srv/projects
PROJECTS_DIR=./projects
