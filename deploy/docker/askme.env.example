# 網站的設定。複製成 askme.env 後改:cp askme.env.example askme.env
# 這裡沒列的設定照程式預設;完整清單與說明見 deploy/env.server.example,要改哪一條就抄進來。
# 改完要 `docker compose up -d --force-recreate askme` 才生效。

# 管理員帳密。⚠️ 預設是 tiptop / tiptop,上線前一定要改
ADMIN_USERNAME=tiptop
ADMIN_PASSWORD=tiptop
# 管理員新增同仁帳號時的預設密碼(同仁第一次登入會被要求改掉)
DEFAULT_USER_PASSWORD=tiptop

# 信任的 IP(逗號分隔,單一位址或網段)。這裡的 IP 永遠不會被「密碼打錯太多次」的 IP 封鎖鎖住。
# 建議填你們的內網網段,例:192.168.1.0/24 —— 不填的話,全公司從同一個位址連進來時可能一起被鎖
LOGIN_IP_ALLOWLIST=

# 預設模型(opus / sonnet),使用者在輸入框還能自己換
CLAUDE_MODEL=opus

# 同時最多幾題在跑(每題一支 claude),以及每人最多幾題
MAX_CONCURRENT_ASKS=10
MAX_CONCURRENT_ASKS_PER_USER=3

# 上傳檔大小上限(MB)
MAX_UPLOAD_MB=50

# ---- SSH 終端機(側邊欄 SSH Server)。不用就保持 0
SSH_TERMINAL_ENABLED=0
# 要連「跑 Docker 的這台主機」就填 host.docker.internal;連別台就填那台的 IP
# SSH_TERMINAL_HOST=host.docker.internal
# SSH_TERMINAL_PORT=22
# SSH_TERMINAL_USER=
# 金鑰與 known_hosts 放在旁邊的 ssh/ 資料夾(見 ssh/README.md)
# SSH_TERMINAL_KEY_FILE=/opt/askme/ssh/id_ed25519
# SSH_TERMINAL_KNOWN_HOSTS=/opt/askme/ssh/known_hosts

# ---- 登入的地理封鎖(只放行台灣 IP)。內網用不到,保持 off
GEO_BLOCK_MODE=off
