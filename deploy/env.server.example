# 所有設定的完整清單與理由(參考用,不會被任何程式自動讀取)。
# Docker 版:要改哪一條就抄進 deploy/docker/askme.env;路徑類的(CLAUDE_BIN、
#   KNOWLEDGE_BASES_FILE、AGENT_KNOWLEDGE_DIR、DATABASE_URL…)由 compose.yml 給,不用抄。
# 開發版:抄進 backend/.env。
# 底下的 /srv/askme/... 路徑都是範例,改成你自己的。
#
# ⚠️ 範本裡的兩組密碼(ADMIN_PASSWORD、DEFAULT_USER_PASSWORD)都是給本機或內網試用的
# 預設值,**上線前務必改掉**。
#
# ⚠️ **這份是完整範本,新變數一律加在這裡。** 本機開發那份
# (`backend/.env.example`)是刻意的子集,只留「少了就會壞、或有功能安靜消失」
# 的幾條;它的每一個 key 這裡都要有。
# 加變數的時候不必同步過去 —— 除非它符合那個判準,理由寫在那份的檔頭。

# claude CLI 執行檔。PATH 找得到就可以填 "claude";服務由別的程式(排程、服務管理員)
# 啟動時 PATH 可能是最小集合,那時要填絕對路徑(`which claude` 的結果)。
CLAUDE_BIN=claude

# **退路**工作目錄,不是所有專案共用的那一個。
#
# 每個專案的 cwd 跟著 knowledge_bases.json 的 workdir 走(那決定載入誰的
# CLAUDE.md / skill、session 存到哪);這裡填的只在兩種情況會用到:
# 該專案沒填 workdir、或填的目錄不存在(會在 log 留 warning)。
#
# agent-knowledge(上傳與產出)**不能**放在這底下,見下面的 AGENT_KNOWLEDGE_DIR。
#
# 不設 = repo 的 workspace/example;換成別的目錄要先建好。
CLAUDE_WORKDIR=/srv/askme/workspace/example

# 專案清單(哪些專案、各自的 workdir / code_roots / knowledge_dirs / skill_dir)。
# 預設 backend/knowledge_bases.json,也就是版控裡那一份 —— **正常情況不要動這行**。
# 指到別的地方等於讓主機上多一份會漂的清單,而漂掉的症狀是「某個專案的隔離
# 安靜地退回退路 workdir」,畫面上完全看不出來。
# 留著這個變數是為了臨時試新環境時能指到副本,驗完就改回來。
KNOWLEDGE_BASES_FILE=/srv/askme/backend/knowledge_bases.json

# 上傳與產生的檔案放哪。**不能落在任何一個專案的 workdir 底下** ——
# cwd 底下的東西不需要 --add-dir 就讀得到,落在某個專案裡等於讓那個專案翻得到
# 所有人的上傳與產出。下載端點要登入擋得住外人(routers/files.py),
# 但擋不住模型自己被指使去讀 —— 這是另一道牆。
# 不設 = backend/data/agent-knowledge;落在專案 workdir 底下時,服務開機會在 log 叫。
AGENT_KNOWLEDGE_DIR=/srv/askme/agent-knowledge

# 工作目錄以外、額外掛給 claude 的路徑(逗號分隔,唯讀)。
# symlink 要填解析後的真實路徑(claude 會先 realpath 再判斷權限,填指向端才有效)。
# ⚠️ 這裡**留空就好** —— 每個專案要讀哪些樹由 knowledge_bases.json 各筆的
#    code_roots/knowledge_dirs 決定,填在這裡等於無條件掛給**所有**專案,
#    那正是專案隔離要避免的事。
CLAUDE_EXTRA_DIRS=

# 單次問答的逾時秒數。跨模組的比較型問題(例如「三種下單流程帶出的欄位差在哪」)
# 要翻好幾支大檔。
# 設成 3600 等於「讓它查到完」,行為比較接近直接在主機上用 claude CLI。
# 逾時也不會整包丟掉 —— 已經寫出來的部分會保留並標記「內容並不完整」(見 agent.py)。
CLAUDE_TIMEOUT_SEC=3600

# 同時最多幾個問答在跑:全站總共 MAX_CONCURRENT_ASKS 題,每人最多
# MAX_CONCURRENT_ASKS_PER_USER 題(0 = 不限)。超過的排隊,不會被拒絕。
MAX_CONCURRENT_ASKS=10
MAX_CONCURRENT_ASKS_PER_USER=3

# 前端「模型」下拉的預設選項會顯示這個值。opus 最準但也最貴,
# 用量統計頁看得到累計花費,覺得不划算再降回 sonnet。
#
# ⚠️ 降成本時**先動 CLAUDE_EFFORT,不要先換模型**。effort 調低是同一個模型想得淺一點
# (知識與能力不變),換模型是換一顆腦袋。留空 = 用 CLI 預設(目前是 high)。
CLAUDE_MODEL=opus
CLAUDE_EFFORT=

# ------------------------------------------------- 快取與成本的三道閘門
#
# prompt cache 是前綴比對。前綴每一題都變的話(指紋見下面 CLAUDE_STATIC_SYSTEM_PROMPT),
# CLAUDE.md、規則檔、整段對話歷史,每一題都用 1.25 倍的寫入價重買一次,
# 而它們本來該用 0.1 倍的讀取價命中。差 12.5 倍。
#
# ⚠️ **前兩個預設是開的**:部署上去、這裡一個字都不改,行為就會變。變的是成本
# 不是答案 —— 兩個都只影響「提示怎麼組」與「載不載入用不到的工具定義」,
# 模型看得到的資訊一模一樣。第三個預設關,因為它**會截斷答案**。

# 把系統提示裡每台機器不一樣的區段(cwd / env / memory paths / git status)搬到
# 第一則使用者訊息,讓前綴保持穩定(預設 1 = 開)。**這是最大的一筆節省。**
#
# 沒開時的指紋:每一題第一輪的 cache_read 停在一個不動的小常數,而 cache_write
# 等於那組對話當下的全長 —— 也就是整段歷史每一題都用 1.25 倍價重買一次。
# 開了之後 cache_read 應該明顯往上跳;**沒跳就是沒生效**,多半是有人加了
# --system-prompt(那會讓這個旗標被 CLI 靜默忽略)。
#
# 模型看到的資訊完全不變,只是換位置 —— 不影響答案品質。
CLAUDE_STATIC_SYSTEM_PROMPT=1

# 不載入主機上設定的 MCP server(預設 1 = 不載入)。
# 服務帳號若在 ~/.claude 掛了別的 MCP server,它們的工具定義每一題都會被載進提示,
# 但工具名稱(mcp__xxx__*)不在任何一組白名單裡 —— 永遠呼叫不到,純付錢。
# 關掉這個開關(設 0)之前先想清楚:MCP 工具**不吃 --add-dir 的路徑限制**。
CLAUDE_STRICT_MCP=1

# 單題成本上限(美金)。**這是停損,不是省錢工具** —— 撞上限的題目會被切斷、
# 答案不完整,所以預設留空(不設限)。CLI 沒有 --max-turns,這是唯一擋得住
# 「一題跑上百步」的煞車。
#
# 要開的話設在「正常題目碰不到」的位置(看 qa_records.cost_usd 的中位數,取 3~4 倍);
# 換模型或改 effort 之後整個分佈會平移,這個值要跟著重設。
#
# ⚠️ **要停用請留空,不要填 0。** 0 對 CLI 是非法值,不是「不限制」——
#    隔壁的 MAX_UPLOAD_MB 才是用 0 表示不限制,兩者不一樣。真的填了 0,
#    config.py 會擋下來並在服務 log 留一行 warning(不會讓每一題都失敗)。
CLAUDE_MAX_BUDGET_USD=

# 這裡刻意**沒有** CLAUDE_AUTOCOMPACT。`claude --help` 有 `--autocompact`,但它是
# **有損**的 —— 壓縮會把舊的工具結果摘要化,而這裡的答案品質標準正好是
# 「檔案:行號」,失真了從答案表面看不出來。理由完整寫在 config.py,加之前先看。

# 工具白名單分兩級,依登入帳號決定拿到哪一組(見 app/auth.py 的 allowed_tools_for)。
# 每次問答會另外疊加四條只限當次 outputs/{session_id} 的寫入規則
# (`Write`/`Edit` × 相對/絕對路徑,寫死在 agent.py 的 scoped_write_rules),程式碼樹仍然完全唯讀。
#
# ── 一般帳號(職稱不是 Software engineer 的同仁)──────────────────
# 唯讀。Read/Grep/Glob 由 agent.scope_readonly_tools 收成路徑限定(這一題該讀的目錄:程式碼樹、skill、附件…)。
# ⚠️ cwd 底下不需要 --add-dir 就讀得到,workdir 底下若還放了別的東西一樣讀得到
#    (見 config.py 那段說明)。這裡**不要加 Bash(...)**,加了路徑限定整個失效。
# 日常問答完全夠用。
CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob

# ── 進階帳號(職稱是 Software engineer 的同仁,以及管理員)──────
# 含 Bash,可以執行主機指令、產生檔案、上網查資料。
#
# ⚠️ **不要把這組設給所有人。** Bash 不受 --add-dir 約束(那個參數只管 Read 工具),
# 所以拿到它就等於「以服務身分讀寫主機上任何東西」:~/.claude 的憑證、這個 .env
# (含資料庫密碼)、~/.ssh 全都在範圍內,只要問一句「幫我印出這個檔案」。
#
# 也不要試圖用 Bash(find:*) 這種寫法「只開一點點」—— 規則比對的是指令開頭,
# 而 `find . -exec <任何指令> \;` 開頭正是 find,等於整個放行。要嘛給 Bash,
# 要嘛不給,中間沒有安全的地帶。
CLAUDE_ALLOWED_TOOLS_FULL=Read,Grep,Glob,Bash,Write,Edit,WebFetch,WebSearch,TodoWrite,Task

# full 帳號額外能寫的目錄(逗號分隔絕對路徑),只掛給 full 帳號的 --add-dir。
# 用途:讓進階帳號把整理好的流程知識累積回某個 skill 的 flows/,例如
#   CLAUDE_FULL_EXTRA_DIRS=/srv/askme/shared-skills/.claude/skills/<某個排查 skill>/flows
# ⚠️ 只掛到 flows/ 這一層,不要掛整個 skill 目錄 —— 掛上一層連 SKILL.md(claude 的
#    排查方法)都能被改,那會影響所有人。flows=知識可寫、SKILL.md=指令唯讀,界線在此。
# 留空 = full 帳號也只能寫當次 outputs。
CLAUDE_FULL_EXTRA_DIRS=

# ⚠️ 不要放 Write,**也不要放 Edit** —— Edit 是「所有會改檔案的工具」的統稱
# (Write 也算),而拒絕優先於允許,放了會讓 outputs 資料夾完全寫不了,
# claude 只會回「請在提示視窗按允許」而 headless 模式根本沒有提示視窗。
CLAUDE_DISALLOWED_TOOLS=NotebookEdit

# 單檔上傳上限(MB)。0 = 不限制,**不要用 0**。
#
# 前面就算有 nginx(`client_max_body_size 100m`,見 deploy/nginx.conf.example),
# 但那是**每個請求**的上限,不是每個帳號的總量:一個登入者迴圈送一萬次 50 MB
# 一樣把硬碟塞滿,而資料庫跟原始碼樹通常在同一顆硬碟上。
# 代理擋的是「單一個巨大請求」,這個值擋的是「單一個巨大檔案」,MIN_FREE_DISK_MB
# 擋的是「累積起來太多」—— 三道擋的不是同一件事,不能互相取代。
# 圖片上傳前在瀏覽器就縮到長邊 1568px 了(4K 截圖縮完只剩幾百 KB),
# 50 對日常用途綽綽有餘。真的需要傳更大的再往上調。
MAX_UPLOAD_MB=50

# 單一請求(整個 multipart)的本文上限(MB)。留空 = MAX_UPLOAD_MB 的兩倍;
# MAX_UPLOAD_MB=0 時這裡也跟著 0(不限制)。見 backend/app/config.py 的 MAX_REQUEST_MB。
#
# 為什麼單檔上限不夠:multipart 一個請求可以塞上千個檔,每個都在 50 MB 以下,
# 加起來照樣是好幾 GB。這條跟 MAX_UPLOAD_FILES 一起把那條路收掉。
# ⚠️ 填了值就要跟 nginx 的 client_max_body_size 對一次 —— 那邊是 100m,
# 這裡要**一致或更小**,不然大請求會被 nginx 先擋掉而錯誤訊息長得不一樣。
MAX_REQUEST_MB=100

# 上傳目錄那顆硬碟剩不到這麼多 MB 時就拒收上傳(預設 2048)。
# 這是「一個帳號把硬碟塞滿」最後的閘:單檔與單請求的上限擋不住一個人送一萬次。
# 留這麼多是給資料庫與 log 的餘裕 —— 硬碟真的滿了是整台機器一起出事。
MIN_FREE_DISK_MB=2048

# 單題問題長度上限(字元,預設 20000)。超過就截斷。
# 使用者送進來的問題最後會變成 claude 子行程的命令列參數,整串 argv 撐爆
# 系統上限的話**子行程根本起不來**,而那時候看到的錯誤跟問題內容完全無關。
MAX_QUESTION_CHARS=20000

# 資料庫。範本預設 SQLite(相對路徑是相對於 backend/),照抄就跑得起來;
# 表由服務啟動時自己建(create_all + ensure_columns),不用手動 migrate。
#
# 多人用建議 PostgreSQL:帳號與資料庫先建好,把底下 SQLite 那行換成註解掉的那一行
# (帳號、密碼、port 換成你的;port 不一定是 5432,`sudo -u postgres psql -qtAc 'show port'` 查)。
# Docker 版已經是 PostgreSQL,DATABASE_URL 由 compose.yml 給,不用設。
# 已經有資料的 SQLite app.db 要搬過去:docs/operations.md〈資料庫:SQLite 與 PostgreSQL〉有步驟(python -m app.migrate_sqlite)。
#
# ⚠️ Postgres 的密碼會寫在這個檔裡,所以這個檔的權限要是 600。
# 寫成 postgresql:// 也行,database.py 會補成 postgresql+psycopg://。
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://askme:<密碼>@localhost:<port>/askme

# 每一步的流水帳(qa_steps)保留幾天。0 = 永遠不刪。
#
# 一題十幾步到上百步,而且**它不去重** —— 流水帳是問答本身的十幾倍到上百倍。
# 不設上限的話幾個月後用量統計頁會開始慢,
# 而那時候再回頭補等於要動歷史資料。
# 90 天的取捨:查成本問題看的一定是最近的資料(「這個月為什麼變貴」),
# 題層級的成本(qa_records.cost_usd)本來就永久保留,長期趨勢看那個就夠。
QA_STEPS_RETENTION_DAYS=90

# 管理員帳密。只有這組看得到用量統計、安全與帳號管理。
# ⚠️ tiptop / tiptop 是**範本預設**,上線前務必改掉(開機只擋空的與佔位字串,不會擋這組)。
ADMIN_USERNAME=tiptop
ADMIN_PASSWORD=tiptop

# 登入嘗試次數限制(見 app/ratelimit.py)。**兩層都開**。
#
# 帳號層 5 次錯鎖 15 分鐘。⚠️ 它**可以被拿來當武器**:
# 知道某個帳號存在的人,故意打錯五次就能把他鎖住。被惡意鎖住時管理員可以在
# 「安全」頁(/security)當場解開。要關回去就設成 0。
# 驗證碼打錯也算進同一組計數器。
# IP 層 10 次就永久封鎖,只能由管理員在 /security 解除。
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SEC=900
LOGIN_IP_MAX_ATTEMPTS=10
# 0 或負數 = 永久封鎖。要改回自動到期就填秒數(例如 900)。
LOGIN_IP_LOCKOUT_SEC=0

# 永遠不會被 IP 層鎖住的來源(公司的對外 IP),逗號分隔,單一位址或 CIDR 都可以。
# **只免 IP 那一層** —— 帳號層(5 次錯鎖 15 分鐘)與地理封鎖照舊。
#
# ⚠️ **上線前要填。** 被鎖的 IP 會寫進資料庫、重啟後還在,重啟服務解不開;
# 整間公司如果共用一個對外 IP,十次登入失敗就會把所有人一起永久鎖在門外,
# 而管理員也在同一個 IP 後面。
#
# ⚠️ 填的是公司出口的**公網位址**,不是 nginx 的來源位址(127.0.0.1 或容器位址)——
# 填 nginx 的位址等於把全世界都放進白名單,IP 層直接失效。
# 查法:在公司網路開瀏覽器連 https://ifconfig.me
LOGIN_IP_ALLOWLIST=

# 前面有 nginx 時才要管這一條。uvicorn 只在請求來源落在這份名單裡時才相信
# X-Forwarded-For / X-Forwarded-Proto —— 不信的話客戶端 IP 會變成 nginx 的位址、
# scheme 一直是 http、HSTS 永遠不送。
#   開發版,nginx 跟 uvicorn 在同一台 → 127.0.0.1(預設)
#   Docker 版,nginx 裝在主機上 → 填 askme 容器看到的來源,也就是 compose 網路的閘道位址
#     (例如 172.18.0.1),不是 127.0.0.1
#   nginx 也跑在容器裡 → 填**那個容器的位址**(容器網段,例如 172.18.0.x)。
#   容器重建時位址可能變,症狀是日誌裡所有人的來源變成同一個容器位址;那時候
#   用 `sudo docker inspect -f '{{json .NetworkSettings.Networks}}' <容器名>` 查新值。
#
# ⚠️ TRUST_PROXY_HEADER 仍然要留空。開了等於不看來源、無條件相信標頭 —— 服務聽在
# 0.0.0.0:8100,同網段任何人都能繞過 nginx 直連並自填 X-Forwarded-For,IP 鎖定形同虛設,
# 還能反過來把別人的 IP 鎖掉。它只留給「uvicorn 前面還有一層它認不出來的代理」的情況。
FORWARDED_ALLOW_IPS=127.0.0.1
# 匿名請求本文上限(KB)與單請求檔案數,理由見 backend/app/config.py。
ANON_MAX_REQUEST_KB=64
MAX_UPLOAD_FILES=20
# 允許哪些 origin 跨站打這個 API。**正式機一律留空。**
# 前後端由同一個 uvicorn 端出去,同一個 origin,瀏覽器不會問 —— 留空就是
# 「連 CORS 中介層都不掛」。填了只會多開一個對外的面。
CORS_ORIGINS=

TRUST_PROXY_HEADER=
AUTH_TOKEN_TTL_SEC=43200

# ── 登入的地理封鎖:只有台灣的 IP 能登入 ──────────────────────────
#
# 用來擋境外 IP 冒用帳號。判定用的是 APNIC 公布的台灣網段,
# 離線查表、不打外部服務(見 backend/app/geoip.py)。清單是 backend/tw_ranges.txt,
# 幾個月重建一次:cd backend && .venv/bin/python build_tw_ranges.py
#
# ⚠️⚠️ **開之前一定要先跑試跑模式,而且先確認上面的 FORWARDED_ALLOW_IPS 是對的。**
# 政策是「判不出國別一律擋」。FORWARDED_ALLOW_IPS 填錯的話,
# client_ip 會對所有人回 nginx 自己的位址(私有位址)→ 判不出來 → **一個人都登不進來**。
# 唯一的例外是內網 172.16.0.0/12:放行,
# **但落在 FORWARDED_ALLOW_IPS 裡的位址照擋**。Docker 的預設網段就在 172 這一段,所以這裡一定要填對
# —— 填錯(或容器重建換了位址沒跟上)時,所有人會被看成代理的位址而被當成內網放行,地理封鎖靜靜失效。
#
# 一個設定三種值,**沒有第二個開關**(兩個布林互相搭配的寫法,
# 打錯一個字就會靜默翻面,而翻錯邊就是全員鎖死):
#   off     = 什麼都不做(預設)
#   dryrun  = 只記錄不擋,稽核寫一筆「地區封鎖試跑」
#   enforce = 真的擋
# 填別的值**服務會拒絕啟動**,不會當成關閉。
#
# 上線順序:
#   1. GEO_BLOCK_MODE=dryrun → 重啟 → 跑幾天
#   2. 查稽核裡有沒有 login_geo_dryrun(「地區封鎖試跑」;安全頁不顯示這一種,
#      用 GET /api/audit?all_events=1 查);有的話先查清楚是誰(出差中的同仁?某條線路走境外出口?)
#   3. 確認乾淨了才換成 GEO_BLOCK_MODE=enforce → 重啟
#
# **同事出差怎麼辦:不必動這個檔,也不必重啟。** 到安全頁的「允許登入的 IP」
# 加一條(請他在當地開瀏覽器查 whatismyip),下一次登入就通;回國後在同一頁刪掉。
# 那份名單存在資料庫,只免地理這一關 —— 密碼與第二關照舊。
#
# 出事的退路:改回 off 再重啟。**服務起不來**的時候看 log ——
# 清單讀不到、或這個值填錯,服務都會拒絕啟動(故意的,不然是全員鎖死又看不出原因)。
GEO_BLOCK_MODE=off

# 閒置多久之後 token 自動失效(秒)。0 = 關掉這個機制。
#
# 這是「關掉瀏覽器就要重新登入」的**伺服器端後盾**:前端那一半全都在瀏覽器那側,
# 而瀏覽器的「回復上次工作階段」會把 sessionStorage 與 session cookie 一起帶回來。
# 關著的瀏覽器不送請求,計時器就不會被推後 —— 所以這個值等於
# 「關掉之後最多還能被救回來多久」。
#
# 網頁本身每 8 秒在輪詢,分頁開著就一直算在使用,60 分鐘不會踢到正在讀答案的人。
AUTH_IDLE_TIMEOUT_SEC=3600


# ---------------------------------------------------------------- 多因子驗證
#
# 驗證器 App(Google Authenticator 那一類)裡顯示的名字。使用者手機上可能同時有
# 十幾個項目,這是他分辨「哪一個是這個系統」的唯一線索。
#
# 綁定之後不要改:它被寫進 otpauth:// 的標籤,而 App 是在綁定的當下把名字記下來的
# —— 改了只會讓新綁的人跟已經綁好的人在同一支手機上顯示成兩個不同的名字。
MFA_ISSUER="AskME 問我問我!"

# 密碼過了、還沒輸入驗證碼之前,那張中間憑證的壽命(秒)。預設 300 = 5 分鐘。
# 夠他拿出手機解鎖找項目,又短到「登入到一半走開去開會」回來要重打密碼。
MFA_CHALLENGE_TTL_SEC=300

# **每個人都一定要有手機驗證碼才登得進來。** 預設關閉。
#
# 關著:只有已經被發過 QR code 的人需要輸入六碼,其他人照舊只用密碼。
# 開著:沒發過的人一律登不進來(密碼對也一樣)。
#
# ⚠️ **順序不能反。** 先開再發的話,那一瞬間所有人都登不進來 —— 包含管理員自己。
# 正確順序:先發給管理員自己(帳號管理頁最上面那張卡片)→ 每個人的 QR 發完 →
# 確認大家都掃過並登入過一次 → 才開這個。管理員自己沒綁就開的話服務會拒絕啟動。
MFA_REQUIRED=0

# **在公司的網路裡就不必輸入六碼。** 預設關閉。
#
# 信任的來源**就是上面那條 LOGIN_IP_ALLOWLIST**,不是另一個設定 —— 兩份公司 IP 遲早會漂掉。
#
# 開著:來源落在白名單裡的登入直接發 token(綁了 MFA 的人不用輸入六碼,
#       MFA_REQUIRED 也不擋沒綁的人)。**所有帳號都適用,包含管理員。**
#       每一次跳過都會在稽核留下一筆 login_mfa_skipped_ip(「公司 IP 免驗證碼」;安全頁不顯示這一種)。
# 關著:照舊,誰都要過第二關。
#
# ⚠️ **這是拿安全換方便,而且換掉的正好是 MFA 唯一在擋的那件事 ——「密碼已經外洩」。**
# 開了之後,任何連得上公司網路的人(訪客 Wi-Fi、被入侵的內網電腦、借出去的筆電)
# 只要有密碼就能登入。
#
# ⚠️ 症狀對照:在公司還是要輸入六碼 = client_ip() 沒拿到真 IP(FORWARDED_ALLOW_IPS
# 或 LOGIN_IP_ALLOWLIST 填錯)。**不要為了「修好它」把 nginx / 容器的位址填進白名單**
# —— 那等於全世界都免第二關,順便把 IP 層的封鎖一起關掉。
MFA_SKIP_ON_TRUSTED_IP=0



# 同仁帳號發下去的預設密碼。系統靠它認出「這個人還沒改過密碼」並在畫面上提示 ——
# 預設密碼大家同一組,在他改掉之前,知道那組密碼的人就能用他的帳號登入,
# 「對話只有自己看得到」對他還不成立。
#
# 帳號由管理員在帳號管理頁建立(只存在資料庫),密碼由使用者自己改。
# 留空的話「建立帳號」與「重設密碼」會被拒絕。
# ⚠️ 這個值等於「所有還沒改密碼的人的密碼」。tiptop 是**範本預設**,上線前務必改成
# 只有管理員知道的一組;發完一輪帳號之後再換掉(換掉不影響已經改過密碼的人)。
DEFAULT_USER_PASSWORD=tiptop

# ---------------------------------------------------------------- SSH 終端機(側邊欄 SSH Server)
# 工程師(職稱 Software engineer)與管理員點了就**直接**以下面這組連進主機,畫面上沒有表單。
# 其他帳號看不到那一列;直接打 /ssh 或直接連 WebSocket 都會被後端擋。
SSH_TERMINAL_ENABLED=1
SSH_TERMINAL_HOST=127.0.0.1
SSH_TERMINAL_PORT=22
SSH_TERMINAL_USER=tiptop

# 憑證二選一,**建議金鑰**:產一對 ed25519(`ssh-keygen -t ed25519 -N ""`),公鑰加進目標帳號的
# ~/.ssh/authorized_keys(目標是本機的話加上 from="127.0.0.1,::1",外洩也只能從主機自己用),
# 這裡填私鑰路徑。Docker 版的放法見 deploy/docker/ssh/README.md(容器裡是 /opt/askme/ssh/id_ed25519)。
# 要收回整個功能:刪掉 authorized_keys 那一行,或把 SSH_TERMINAL_ENABLED 設 0。
#
# 範本刻意留空:金鑰還沒放好之前就填,工程師會看到 SSH Server 那一列卻連不上。
SSH_TERMINAL_KEY_FILE=
# 主機不允許金鑰登入時才用這條;有填就會走密碼。兩個都空 = 功能關閉(開機 warning 一次),
# 側邊欄不會出現 SSH Server。
SSH_TERMINAL_PASSWORD=

# 主機金鑰(known_hosts 格式)。檔案不存在或對不上一律**拒連**,不會問使用者要不要信任
# —— 沒有表單就沒有地方按信任,而且目標只有一台、本來就該在部署時定好。
# 產生:ssh-keyscan -t ed25519 <目標主機> > <這個檔>(Docker 版容器裡是 /opt/askme/ssh/known_hosts)。
SSH_TERMINAL_KNOWN_HOSTS=/srv/askme/backend/data/ssh_known_hosts

# 檔案欄一開始停在哪。~ = 登入帳號的家目錄。
SSH_TERMINAL_START_DIR=~

# 幾秒沒鍵盤輸入、也沒檔案操作就自動斷線。純輸出不算:tail -f 放著一樣會斷。
#
# ⚠️ **0 = 不自動斷線(預設)**:前端 3 分鐘沒操作會蓋上主機清單當**螢幕保護**
# (不是斷線,點回去就繼續),**關掉網頁 / 離開那一頁才斷**。
# 要自動斷線就填秒數(例如 600)。
# ⚠️ 填了秒數的話,nginx /api/terminal/ 的 proxy_read_timeout 要**大於**它
# (見 nginx.conf.example),不然閒著的 WebSocket 會先被 nginx 切掉,原因會是錯的。
SSH_TERMINAL_IDLE_TIMEOUT_SEC=0
# 幾秒送一則 keepalive。**跟閒置無關**,而且**一個值管兩段線**:
#  ① 給瀏覽器:讓中間的 nginx 看到有流量,不然「不自動斷線」會被 proxy_read_timeout
#     (範本 660s)打回原形:沒人動的連線照樣被切,而使用者看到的原因是「網路中斷」。
#  ② 給主機那條 SSH(asyncssh 的 keepalive_interval):後端要多久才發現「這裡 ↔ 主機」
#     那一段死了 = 這個值 × 3。連到遠端主機時,中間的 NAT / 防火牆會悄悄回收閒置連線。
# 0 = 兩段都不送(不只是 ①)。
SSH_TERMINAL_KEEPALIVE_SEC=240
# 連 sshd 的逾時(秒)。
SSH_TERMINAL_CONNECT_TIMEOUT_SEC=10

# 一個人同時最多開幾條(頁籤的上限)。每一條都是主機上一個 sshd session + 一條 SFTP。
SSH_TERMINAL_MAX_SESSIONS=4

# 終端機旁邊 AskME 用哪個模型。**跟問答的 CLAUDE_MODEL 分開** —— 問答那邊為了省錢
# 改成 sonnet 的時候,這個面板不該跟著變。只收白名單裡的值,其他退回 opus。
TERMINAL_AI_MODEL=opus

# 主機清單的位置(預設 backend/terminal_hosts.json,見下面那一段)。
# TERMINAL_HOSTS_FILE=/srv/askme/backend/terminal_hosts.json

# ── 多台主機。/ssh 進來先看主機清單,點哪一台連哪一台 ──
#
# 沒有 terminal_hosts.json 時,清單上只有上面那組 SSH_TERMINAL_* 那一台(id = main)。
# 要多台就建這個檔:
#   cp backend/terminal_hosts.example.json backend/terminal_hosts.json
# ⚠️ **有這個檔就以它為準,是整份取代,不是追加**:.env 的 SSH_TERMINAL_* 那一台
# 不會自動加進清單,要的話自己在檔裡寫一筆。
# terminal_hosts.json **不進版控**(位址與帳號是部署資訊),而且裡面**不放密碼** ——
# 要用密碼登入的主機在 json 裡填 password_env,值寫在這裡,例如:
# CUSTOMER_SSH_PASSWORD=
# 每台主機的 logo 放法見 docs/architecture.md 的「SSH 終端機:側邊欄的 SSH Server」。

# ── Work Flow(側邊欄 SSH Server 底下那一列;可選,不用就整段不管)──
#
# 排程拼圖:在畫布上把「連線 → 同步 → 執行腳本 → 通知人員 → 中斷連線」接起來,
# 後端照排程經 SSH 在主機上跑。跟 SSH Server 同一群人、同一組連線(上面的 SSH_TERMINAL_* 與 terminal_hosts.json)。
# **有 backend/workflow_actions.json 才會出現**(沒有的話側邊欄沒有這一列、/api/workflows 是 404、排程器不啟動):
#   cp backend/workflow_actions.example.json backend/workflow_actions.json
# 改裡面的指令(建立 / 拆掉連線、同步),然後重啟服務。那個檔**不進版控**。
# WORKFLOW_ACTIONS_FILE=/srv/askme/backend/workflow_actions.json
#
# 排程用的時區(比 UTC 快幾分鐘)。預設 +480(UTC+8)。
# WORKFLOW_UTC_OFFSET_MIN=480

# ---------------------------------------------------------------- 個人筆記(側邊欄 Notes)
# 預設開。要關就取消下一行的註解、重啟服務:
# 側邊欄沒有 Notes、對話裡沒有存筆記的鈕,/api/notebook 回 404。資料表與 data/notebook 不受開關影響。
# NOTEBOOK_ENABLED=0
