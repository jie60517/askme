# 本機開發用的最小 .env 範本(cp .env.example .env)。Docker 版不讀這份,改 deploy/docker/askme.env。
#
# ⚠️ **完整清單在 `deploy/env.server.example`** —— 那份才是完整範本:所有現行變數
# (兩級工具白名單、登入鎖定、AGENT_KNOWLEDGE_DIR……)連同每一條的
# 理由都在那裡。這份只留本機把服務跑起來需要的幾行,**新變數一律加在那份,
# 不要加在這裡** —— 兩份各自演化的話,這份會漂到教人打開安全洞的程度
# (例如寫上 `Bash(find:*)`,而 find -exec 等於放行任意指令)。
#
# ── 這份比 env.server.example 少了 30 幾條,那是刻意的 ──────────────────
#
# 這份的每一個 key 在 env.server.example 裡都有,而那份多出來的絕大多數是
# 主機上才會用到的(地理封鎖、反向代理、磁碟與配額上限)。
#
# **要不要把某一條補進這份的判準只有一個:少了它,本機會不會壞掉、
# 或有功能安靜地消失。** 不是「主機上有所以這裡也要有」——
# 把兩份補成一樣只會讓下一個人以為本機需要設一堆其實不需要的東西。
#
# 照這個判準補進來的,底下都標了「⚠️ 少了會…」:
#   DEFAULT_USER_PASSWORD   —— 少了就不能建帳號 / 重設密碼
#   SSH_TERMINAL_ENABLED    —— 預設是**開**的,缺憑證時那一列安靜消失
#   LOGIN_IP_ALLOWLIST      —— 少了它,本機打錯 10 次密碼會把自己永久鎖住
#
# 其餘的請直接看 `deploy/env.server.example`,不要往這裡搬。

# claude CLI 執行檔。本機互動 shell 的 PATH 找得到就可以留 "claude";
# 由別的程式(排程、服務管理員)啟動時 PATH 可能是最小集合,那時要填絕對路徑。
CLAUDE_BIN=claude

# **退路**工作目錄。每個專案的 cwd 跟著 knowledge_bases.json 的 workdir 走,
# 這裡只在「該專案沒填 workdir、或填的目錄不存在」時才用得到。
# 不設 = repo 的 workspace/example(config.py 的預設);要指到別處就打開這一行。
# CLAUDE_WORKDIR=/srv/askme/workspace/my-project

# 專案資料夾。底下每個子資料夾自動當成一個專案(放進去重新整理網頁就看得到)。
# 不設 = repo 的 workspace/;專案放在別處就打開這一行。
# WORKSPACE_DIR=/srv/askme/workspace

# 上傳與產出放哪。**不能落在任何專案的 workdir 底下**(理由見
# env.server.example —— 落在專案裡等於讓那個專案翻得到所有人的上傳與產出)。
# 不設 = backend/data/agent-knowledge(config.py 的預設);主機上建議另外指一個目錄。
# AGENT_KNOWLEDGE_DIR=/srv/askme/agent-knowledge

# 單次問答逾時秒數。跨模組的比較型問題要翻好幾支大檔,
# 3600 = 「讓它查到完」(config.py 的預設值)。
CLAUDE_TIMEOUT_SEC=3600

# 前端「預設」選項會直接顯示這裡的值(config.py 預設 opus)。
# 降成本時先動 effort(同一顆腦袋想淺一點)再考慮換模型,理由見 env.server.example。
CLAUDE_MODEL=opus
CLAUDE_EFFORT=

# 讓系統提示保持穩定,好讓 prompt cache 命中(預設 1)。最大的一筆節省,見 env.server.example。
CLAUDE_STATIC_SYSTEM_PROMPT=1

# 不載入主機上的 MCP server(預設 1)。那些工具名稱不在白名單裡,載了也呼叫不到。
CLAUDE_STRICT_MCP=1

# 這裡刻意**沒有** CLAUDE_AUTOCOMPACT:`--autocompact` 是有損的(會把舊的工具結果
# 摘要化),而這裡的答案品質標準是「檔案:行號」。理由完整寫在 config.py。

# 單題成本上限(美金)。留空 = 不設限。**要停用請留空,不要填 0**(0 是非法值)。
# 這是停損不是省錢工具 —— 撞上限的題目會被切斷。取捨見 env.server.example。
CLAUDE_MAX_BUDGET_USD=

# 一般帳號的唯讀白名單。**不要加任何 Bash(...) 寫法** —— 規則比對的是指令開頭,
# `find . -exec <任何指令> \;` 開頭正是 find,等於整個放行(詳見 env.server.example
# 與 config.py 的說明)。進階帳號的 FULL 那組也定義在 env.server.example。
CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob

# ⚠️ 不要放 Write,也不要放 Edit —— 拒絕優先於允許,放了會讓 outputs 完全寫不了。
CLAUDE_DISALLOWED_TOOLS=NotebookEdit

# 單檔上傳上限(MB)。0 = 不限制,**不要用 0**(理由見 config.py)。
MAX_UPLOAD_MB=50

# 單一請求(整個 multipart)的本文上限(MB)。留空 = MAX_UPLOAD_MB 的兩倍。
# 主機上前面的 nginx 也有一道 client_max_body_size,那是第一道、這是第二道
# (內網直連 uvicorn 也擋得住)。兩邊要一致或這邊更小。
MAX_REQUEST_MB=

# 資料庫。範本預設 SQLite(clone 下來不用裝 Postgres 就能跑);多人用建議 PostgreSQL,
# 帳號與資料庫先建好,再換成下面那行 —— 程式兩種都支援,測試預設走 SQLite 的暫存檔。
# 寫成 postgresql:// 也可以,database.py 會自己補成 postgresql+psycopg://。
# 從舊的 app.db 搬資料:python -m app.migrate_sqlite data/app.db(見 README〈資料庫〉)。
# ⚠️ 帳號、密碼、port 換成你的(port 不一定是 5432),別把範例那行原樣抄上去。
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://askme:askme@localhost:5432/askme

# 管理員帳密(用量統計 / 安全 / 帳號管理三頁)。
# 範本預設 tiptop / tiptop(config.py 的預設值也是),**上線前請改**。
# 開機只擋空值與幾個一看就是佔位的字串(changeme、password 等,清單見 config.ADMIN_PASSWORD_PLACEHOLDERS),
# tiptop 不在清單裡,照常開機。
ADMIN_USERNAME=tiptop
ADMIN_PASSWORD=tiptop

# 管理員建帳號 / 重設密碼時,發給對方的初始密碼(他首次登入會被強制改掉)。
#
# ⚠️ **少了這一行,帳號管理頁的「建立帳號」與「重設密碼」會直接被擋**,
# 回 409「主機的 .env 還沒設 DEFAULT_USER_PASSWORD」(routers/admin_users.py)。
# 這不是警告是拒絕 —— 程式**刻意沒有預設值**:寫在程式裡的字面值等於把
# 初始密碼寫進版控,拿它登入任何還沒改密碼的帳號就能把帳號接管過去。
#
# 範本預設 tiptop,**上線前請改**。**不要留空、也不要填 changeme**(那兩個都被當成「還沒設」,
# 見 config.DEFAULT_USER_PASSWORD_PLACEHOLDERS)。用 ASCII —— 這組密碼是要有人
# 真的在登入欄裡打進去的。
DEFAULT_USER_PASSWORD=tiptop
# 登入 token 有效期限(秒),預設 12 小時
AUTH_TOKEN_TTL_SEC=43200

# 閒置多久之後 token 自動失效(秒)。0 = 關掉這個機制。
#
# 這是「關掉瀏覽器就要重新登入」的**伺服器端後盾**:前端那一半全都在瀏覽器那側,
# 而瀏覽器的「回復上次工作階段」會把 sessionStorage 與 session cookie 一起帶回來。
# 關著的瀏覽器不送請求,計時器就不會被推後 —— 所以這個值等於
# 「關掉之後最多還能被救回來多久」。
#
# 網頁本身每 8 秒在輪詢,分頁開著就一直算在使用,60 分鐘不會踢到正在讀答案的人。
AUTH_IDLE_TIMEOUT_SEC=3600


# ---------------------------------------------------------------- 多因子驗證
#
# 驗證器 App(Google Authenticator 那一類)裡顯示的名字。使用者手機上可能同時有
# 十幾個項目,這是他分辨「哪一個是這個系統」的唯一線索。
#
# 綁定之後不要改:它被寫進 otpauth:// 的標籤,而 App 是在綁定的當下把名字記下來的
# —— 改了只會讓新綁的人跟已經綁好的人在同一支手機上顯示成兩個不同的名字。
MFA_ISSUER="AskME 問我問我!"

# 密碼過了、還沒輸入驗證碼之前,那張中間憑證的壽命(秒)。預設 300 = 5 分鐘。
# 夠他拿出手機解鎖找項目,又短到「登入到一半走開去開會」回來要重打密碼。
MFA_CHALLENGE_TTL_SEC=300

# **每個人都一定要有手機驗證碼才登得進來。** 預設關閉。
#
# 關著:只有已經被發過 QR code 的人需要輸入六碼,其他人照舊只用密碼。
# 開著:沒發過的人一律登不進來(密碼對也一樣)。
#
# ⚠️ **順序不能反。** 先開再發的話,那一瞬間所有人都登不進來 —— 包含管理員自己。
# 正確順序:帳號管理頁把每個人的 QR 發完 → 確認大家都掃過並登入過一次 → 才開這個。
MFA_REQUIRED=0

# **從信任的網路登入就不必輸入六碼。** 預設關閉。
#
# 信任的來源**就是下面那條 LOGIN_IP_ALLOWLIST**,不是另一個設定 ——
# 兩份 IP 清單遲早會對不上。
#
# 開著:來源落在白名單裡的登入直接發 token(綁了 MFA 的人不用輸入六碼,
#       MFA_REQUIRED 也不擋沒綁的人)。**所有帳號都適用,包含管理員。**
#       每一次跳過都會在安全頁的「登入」分類留下「公司 IP 免驗證碼」。
# 關著:照舊,誰都要過第二關。
#
# ⚠️ **這是拿安全換方便,而且換掉的正好是 MFA 唯一在擋的那件事 ——「密碼已經外洩」。**
# 開了之後,任何連得上那個網路的人(訪客 Wi-Fi、被入侵的內網電腦、借出去的筆電)
# 只要有密碼就能登入。
#
# ⚠️ 症狀對照:從信任的網路登入還是要輸入六碼 = client_ip() 沒拿到真 IP(FORWARDED_ALLOW_IPS
# 或 LOGIN_IP_ALLOWLIST 填錯)。**不要為了「修好它」把 nginx / 容器的位址填進白名單**
# —— 那等於全世界都免第二關,順便把 IP 層的封鎖一起關掉。
MFA_SKIP_ON_TRUSTED_IP=0

# 登入失敗幾次鎖帳號。0 = 關掉這一層。
#
# ⚠️ 帳號層**可以被拿來當武器**:知道某個帳號存在的人,故意打錯五次就能把他鎖住
# 15 分鐘。被惡意鎖住時管理員可以在 /security 當場解開。
# 驗證碼打錯也算進同一組計數器。
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SEC=900

# 信任的對外 IP(例如辦公室出口),逗號分隔,單一位址或 CIDR。這份名單管兩件事:
#   1. 永遠不會被 IP 層鎖住(帳號層照舊)。
#   2. MFA_SKIP_ON_TRUSTED_IP=1 時,從這裡來的登入不必過第二關。
# 地理封鎖**不看**這一份 —— 出差用的例外在安全頁的「允許登入的 IP」加
# (存資料庫,不必重啟)。
#
# ⚠️ IP 層預設是 10 次**永久封鎖**,而且會寫進資料庫、重啟後還在 ——
# 很多人共用一個對外 IP 的話,少了這份名單就可能一起被鎖死而且重啟也救不回來
# (怎麼救見 app/routers/locks.py 檔頭)。
#
# ⚠️ **本機開發請填 127.0.0.1,不要留空。** 這條同樣會鎖你自己:白名單**沒有
# 任何預設值**,localhost 不是例外(`ratelimit._allow_networks()` 只讀這個變數),
# 而本機直連拿到的 client_ip 就是 127.0.0.1。密碼打錯 10 次 —— 例如剛 clone 下來
# 還沒設好 ADMIN_PASSWORD 的時候 —— 就把自己永久鎖在門外,而且那筆封鎖寫進
# 資料庫,**重啟服務也解不開**。要解得去 /security 按解鎖,或改這一行再重啟。
LOGIN_IP_ALLOWLIST=127.0.0.1,::1



# 本機開發時 vite dev server(5173)跟後端(8123)是**不同的 origin**,
# 不填這行的話瀏覽器會擋掉所有 API 請求。上線時前後端同一個 uvicorn、
# 同一個 origin,**要留空**(留空 = 完全不掛 CORS 中介層)。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ---------------------------------------------------------------- SSH 終端機
#
# ⚠️ **這個開關的預設是「開」**(`config.py` 的 `_env_enabled(..., default=True)`)。
# 沒設憑證(SSH_TERMINAL_KEY_FILE / SSH_TERMINAL_PASSWORD)的時候,功能視為關閉:
# 側邊欄那一列不會出現、WebSocket 回 4404 —— **而畫面上沒有任何錯誤**。
# 開機時 log 會印一行 warning,那是唯一的線索。
#
# 所以這裡明寫 0:本機沒有 sshd,讓那一列乾脆不要出現,比「出現了但點不動」清楚。
#
# ⚠️ **「把 SSH_TERMINAL_* 整組從 .env 拿掉」不等於關掉它。** 這個開關本身是真的
# (`ssh_terminal_available()` = `SSH_TERMINAL_ENABLED and (KEY_FILE or PASSWORD)`),
# 但它**預設是開**,所以不寫等於開著 —— 要關就得明確寫一行 =0。
#
# **要在本機試 SSH 終端機那一頁,不要在這裡設連線資訊** —— Windows 沒有 sshd,
# 而拿真主機的密碼來試畫面是不對的。改用示範模式,它在同一個行程裡
# 起一個 asyncssh 的假 sshd(含假的 /dev/pts 與 SFTP),用暫存 SQLite、不碰
# data/app.db:
#
#     .claude/launch.json 的 backend-demo(8124)+ frontend-demo(5174)
#     或 backend/ 底下直接跑:.venv/Scripts/python dev_terminal_demo.py
#
# 管理員帳密固定在 dev_terminal_demo.py 開頭。⚠️ demo 每次重啟都是**新的暫存 DB**,
# 舊的登入狀態會失效。主機上的 SSH_TERMINAL_* 全套見 deploy/env.server.example。
SSH_TERMINAL_ENABLED=0
